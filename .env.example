# Copy this file to .env and fill in your own ITU Ninova credentials.
# Never commit your real .env file.

NINOVA_USERNAME=your_itu_username
NINOVA_PASSWORD=your_itu_password

# Optional
NINOVA_BASE_URL=https://ninova.itu.edu.tr
NINOVA_STATE_DIR=.ninova_state
NINOVA_DISABLE_PLAYWRIGHT_FALLBACK=0

# Optional: only needed for remote HTTP deployments such as Claude.ai custom connectors.
NINOVA_REMOTE_HOST=0.0.0.0
NINOVA_REMOTE_PORT=8000
NINOVA_REMOTE_MCP_PATH=/mcp-change-this-to-a-long-random-secret
NINOVA_PUBLIC_BASE_URL=https://your-domain.example.com
NINOVA_ALLOWED_HOSTS=your-domain.example.com
NINOVA_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
