# Copy this file to .env and fill in your own ITU credentials.
# The same account is used for Ninova and OBS (both use ITU's girisv3 login).
# Never commit your real .env file.

NINOVA_USERNAME=your_itu_username
NINOVA_PASSWORD=your_itu_password

# Optional: only if OBS should use a different ITU account than Ninova.
# ITU_USERNAME=
# ITU_PASSWORD=
